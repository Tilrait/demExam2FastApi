{% extends "./layout.jinja2" %}

{% block title %}Панель администратора{% endblock %}

{% block header %}
<span>{{ login }}</span>
<form action="/logout" method="get">
    <button class="button" type="submit">Выйти</button>
</form>
{% endblock %}

{% block content %}
<section class="admin-heading">
    <h1>Заявки на обучение</h1>
    <p>Всего заявок: <strong>{{ total }}</strong></p>
</section>

{% if message %}
<article id="notice" class="notice" role="status">{{ message }}</article>
{% endif %}

<form method="get" action="/admin" class="admin-filters">
    <label for="search">Поиск по клиенту или курсу
        <input id="search" type="search" name="search" value="{{ search }}" placeholder="Логин или название курса">
    </label>
    <label for="status">Статус
        <select id="status" name="status">
            <option value="">Все статусы</option>
            {% for value in statuses %}
            <option value="{{ value }}" {% if status_filter == value %}selected{% endif %}>{{ value }}</option>
            {% endfor %}
        </select>
    </label>
    <button class="button" type="submit">Применить</button>
    <a class="link" href="/admin">Сбросить</a>
</form>

<article>
    <div class="table-wrap">
    <table>
        <thead>
            <tr>
                <th>Клиент</th>
                <th>Курс</th>
                <th>Тип оплаты</th>
                <th>Дата старта</th>
                <th>Статус</th>
            </tr>
        </thead>
        <tbody>
            {% for record in records %}
            <tr>
                <td>{{ record.user_login }}</td>
                <td>{{ record.course }}</td>
                <td>{{ record.payment }}</td>
                <td>{{ record.date }}</td>
                <td>
                    <form method="post" action="/status" style="display: flex; align-items: center; gap: 8px;">
                        <select name="new_status" class="select" aria-label="Статус заявки {{ record.id }}">
                            <option value="Новая" {% if record.status=="Новая" %}selected{% endif %}>Новая</option>
                            <option value="Идет обучение" {% if record.status=="Идет обучение" %}selected{% endif %}>
                                Идет обучение</option>
                            <option value="Обучение завершено" {% if record.status=="Обучение завершено" %}selected{%
                                endif %}>Обучение завершено</option>
                        </select>
                        <input name="record_id" value="{{ record.id }}" hidden />
                        <button class="button" type="submit" style="width: max-content;">✔</button>
                    </form>
                </td>
            </tr>
            {% endfor %}
            {% if not records %}
            <tr><td colspan="5" class="empty-state">Заявки по выбранным условиям не найдены.</td></tr>
            {% endif %}
        </tbody>
    </table>
    </div>
</article>

{% if page_count > 1 %}
<nav class="pagination" aria-label="Страницы заявок">
    {% if page > 1 %}<a class="button secondary" href="/admin?page={{ page - 1 }}&status={{ status_filter|urlencode }}&search={{ search|urlencode }}">← Назад</a>{% endif %}
    <span>Страница {{ page }} из {{ page_count }}</span>
    {% if page < page_count %}<a class="button secondary" href="/admin?page={{ page + 1 }}&status={{ status_filter|urlencode }}&search={{ search|urlencode }}">Вперед →</a>{% endif %}
</nav>
{% endif %}

<script>
    const notice = document.getElementById("notice");
    if (notice) setTimeout(() => notice.remove(), 3500);
</script>
{% endblock %}
